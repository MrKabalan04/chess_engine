{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Chess Engine",
            "command": "g++",
            "args": [
                "-O2",
                "--std=c++20",
                "-DNDEBUG",
                "board.cpp",
                "pawns.cpp",
                "leapers.cpp",
                "sliders.cpp",
                "utilities.cpp",
                "generateMoves.cpp",
                "main.cpp",
                "uci.cpp",
                "-o",
                "${fileDirname}\\chess_engine.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compiler: g++"
        }
    ]
}